NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/taru_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Client (Vite dev server default: 5173)
CLIENT_URL=http://localhost:5173

# Object Storage (S3-compatible)
OBJECT_STORAGE_ENDPOINT=https://s3.amazonaws.com
OBJECT_STORAGE_BUCKET=taru-media
OBJECT_STORAGE_ACCESS_KEY=your_access_key
OBJECT_STORAGE_SECRET_KEY=your_secret_key

# Payment Provider
PAYMENT_PROVIDER=razorpay
PAYMENT_SECRET=your_payment_secret
PAYMENT_WEBHOOK_SECRET=your_webhook_secret

# LLM
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your_embedding_api_key

# Vector Search
VECTOR_INDEX_NAME=taru_knowledge

# AI Environment
AI_ENV=development
